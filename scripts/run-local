#!/usr/bin/env python3
"""Run the packaged application in the foreground; Ctrl-C shuts it down."""
import argparse
import os
import sys
from pathlib import Path
from ar_local import build_launch

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--check', action='store_true', help='Validate local configuration without connecting to the database')
    args = parser.parse_args()
    try:
        command, environment = build_launch(Path(__file__).resolve().parent.parent, os.environ)
        if args.check:
            print('Local launch configuration is ready; database connectivity has not been checked.')
            return 0
        os.execve(command[0], command, environment)
    except ValueError as error:
        print(str(error), file=sys.stderr)
        return 1
    except OSError:
        print('Local launch failed; check JDK, artifact, and file access.', file=sys.stderr)
        return 1

if __name__ == '__main__':
    raise SystemExit(main())
